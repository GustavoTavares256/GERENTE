{
  "name": "gerente-codxis-bot",
  "version": "0.1.0",
  "description": "Agente Gerente da Codxis — check-in/check-out diário de tarefas via WhatsApp",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:console": "tsx src/index-console.ts",
    "dev:dashboard": "tsx src/dashboard/start-dashboard.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
