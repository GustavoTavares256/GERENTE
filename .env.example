# Configuração local — copie para `.env` e preencha.
# O arquivo `.env` é ignorado pelo git (nunca suba chaves reais).

# Banco de dados PostgreSQL
DATABASE_URL=postgres://codxis:codxis@localhost:5433/codxis

# IDs (ex.: número do WhatsApp) da gestão, separados por vírgula
GESTAO_IDS=

# Lista fixa de colaboradores que recebem as mensagens automáticas dos turnos,
# separados por vírgula (ex.: números do WhatsApp com @c.us no WhatsApp)
FUNCIONARIOS_IDS=

# Identificador do tenant (multi-tenant)
TENANT_ID=codxis

# Dashboard
PORT=3111
HOST=127.0.0.1

# Agendador de turnos automáticos (sem precisar digitar comando)
# Hora do lembrete de check-in (manhã)
HORA_CHECKIN=10:00
# Hora da cobrança de check-in para quem não registrou (início da tarde)
HORA_COBRANCA_CHECKIN=14:30
# Hora do check-out + sugestões individuais do colaborador (fim do expediente)
HORA_CHECKOUT=16:30
# Liga/desliga o agendador (true/false)
AGENDADOR_ATIVO=true

# Provedor LLM para as sugestões inteligentes (OpenAI-compatible).
# Sem OPENAI_API_KEY, o bot usa o fallback por regras.
# OpenAI:        base padrão https://api.openai.com/v1, modelo gpt-4o-mini
# Groq (grátis): OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_MODEL=llama-3.3-70b-versatile
# Ollama (local):OPENAI_BASE_URL=http://localhost:11434/v1         OPENAI_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Canal WhatsApp via UAZAPI (provedor por API REST) ─────────────────────
# Roda com `npm run dev:uazapi`. A sessão do WhatsApp vive na instância UAZAPI
# (pairing via QR no painel deles, não no terminal). Dispara turnos e conversa
# guiada normalmente, sem depender do whatsapp-web.js.
# UAZAPI_BASE_URL=https://free.uazapi.com
# UAZAPI_TOKEN=
